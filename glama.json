{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "name": "cortical-mcp",
  "version": "0.3.0",
  "description": "Zero-server, Python 3.10+ stdlib-only MCP server providing a fail-closed Privacy Vault, lossless TOON compression, hardware preflight, zero-cloud-token local LLM offload, ROI telemetry, cross-harness handoff, and Prompt Studio.",
  "type": "mcp_server",
  "status": "active",
  "maintainers": [
    "ccancellieri"
  ],
  "transport": [
    "stdio",
    "streamable-http"
  ],
  "entryPoint": "python3 -m cortical.mcp_server",
  "keywords": [
    "privacy-vault",
    "pii-redaction",
    "toon-compression",
    "zero-dependencies",
    "local-llm",
    "ollama",
    "unsloth",
    "cross-harness",
    "prompt-studio",
    "second-brain"
  ],
  "tools": [
    "cortical_vault_read",
    "cortical_ingest_private",
    "cortical_compress",
    "cortical_doctor_status",
    "cortical_local_offload",
    "cortical_roi_report",
    "cortical_handoff",
    "cortical_next_prompt"
  ],
  "features": {
    "resources": true,
    "prompts": true,
    "completions": true,
    "toolAnnotations": true,
    "outputSchema": true
  }
}
