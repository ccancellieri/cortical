{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cortical-mcp": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "cortical.mcp_server"
      ],
      "environment": {
        "PYTHONPATH": "./src",
        "CORTICAL_VAULT_DB": "./.cortical_data/vault.db"
      },
      "enabled": true
    }
  }
}
