{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "cortical": {
        "type": "local",
        "command": [
          "python3",
          "-m",
          "cortical.mcp_server"
        ],
        "environment": {
          "PYTHONPATH": "./src",
          "CORTICAL_VAULT_DB": "./.cortical_data/vault.db"
        },
        "disabled": false
      }
    }
  }
}
