{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "cortical-wiki": {
        "type": "local",
        "command": [
          "python3",
          "-m",
          "cortical.wiki.mcp_server"
        ],
        "environment": {
          "PYTHONPATH": "./src",
          "CORTICAL_WIKI_DB": "./.cortical_data/wiki.db"
        },
        "disabled": false
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browserUrl=http://127.0.0.1:9222",
          "--no-usage-statistics",
          "--no-performance-crux"
        ],
        "disabled": false
      }
    }
  }
}
