{
  "name": "cortical-pi-harness",
  "version": "0.2.0",
  "description": "Zero-Dependency 4-Tier Merkle Second Brain MCP, Dynamic 200k Context Auto-Scaler, Zero-Token ROI Analytics & Adaptive Permission Gate for pi / OpenCode",
  "license": "Apache-2.0",
  "author": "Carlo Cancellieri (https://github.com/ccancellieri)",
  "homepage": "https://ccancellieri.github.io/cortical/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ccancellieri/cortical.git"
  },
  "keywords": [
    "pi-package",
    "opencode",
    "mcp",
    "agentskills",
    "second-brain",
    "ollama"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions"
    ],
    "skills": [
      "./.agents/skills"
    ]
  },
  "type": "module",
  "scripts": {
    "setup": "bash ./scripts/setup.sh",
    "doctor": "PYTHONPATH=src python3 -m cortical.cli doctor",
    "token-report": "PYTHONPATH=src python3 -m cortical.cli token-report --narrative",
    "test": ".venv/bin/python -m unittest discover -s tests -v"
  }
}
