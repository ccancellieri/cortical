{
  "name": "cortical-pi-harness",
  "version": "0.3.0",
  "description": "Cross-Platform Zero-Server Agent Control Plane & Declarative Composer with Dynamic Privacy Vault, Lossless TOON Compression & Variable-Quant Model Auto-Tuner",
  "license": "Apache-2.0",
  "author": "Carlo Cancellieri (https://github.com/ccancellieri)",
  "homepage": "https://ccancellieri.github.io/cortical/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ccancellieri/cortical.git"
  },
  "keywords": [
    "pi-package",
    "opencode",
    "deepseek-harness",
    "mcp",
    "privacy-vault",
    "toon",
    "ollama",
    "unsloth"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions"
    ],
    "skills": [
      "./.agents/skills"
    ]
  },
  "type": "module",
  "scripts": {
    "setup": "bash ./scripts/setup.sh",
    "doctor": "PYTHONPATH=src python3 -m cortical.cli doctor",
    "sync": "PYTHONPATH=src python3 -m cortical.cli sync",
    "bench": "PYTHONPATH=src python3 -m cortical.cli bench --compare",
    "roi": "PYTHONPATH=src python3 -m cortical.cli roi",
    "test": ".venv/bin/python -m unittest discover -s tests -v"
  }
}
